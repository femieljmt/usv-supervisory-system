APP_ENV=development

VEHICLE_ID=usv-01

MAVLINK_CONNECTION=udpin:0.0.0.0:14551
MAVLINK_HEARTBEAT_TIMEOUT=5.0
MISSION_REFRESH_INTERVAL_SECONDS=15.0
GUIDED_TARGET_MESSAGE_INTERVAL_SECONDS=1.0
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30.0

MQTT_HOST=CHANGE_ME
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30
MQTT_QOS=1

ACK_TIMEOUT_SECONDS=3.0
LOG_INTERVAL_SECONDS=1.0
SYNC_BATCH_SIZE=10

OUTBOX_DB_PATH=data/database/onboard_outbox.sqlite3
LOCAL_LOG_DIR=data/logs

INTERNET_PROBE_TARGETS=1.1.1.1:443,8.8.8.8:443
INTERNET_PROBE_INTERVAL_SECONDS=2.0
INTERNET_PROBE_TIMEOUT_SECONDS=1.0
INTERNET_SUCCESS_CONFIRMATIONS=2
INTERNET_FAILURE_CONFIRMATIONS=3
